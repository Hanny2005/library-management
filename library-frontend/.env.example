# ================================================================
# Sao chép file này thành ".env" rồi điền giá trị thật của bạn.
# File .env đã nằm trong .gitignore — KHÔNG commit lên Git.
# ================================================================

# true  = dùng dữ liệu xem trước (chưa có backend). Giai đoạn 1 để true.
# false = gọi API thật tới Spring Boot (từ Giai đoạn 5 trở đi).
VITE_USE_MOCK=true

# Địa chỉ backend Spring Boot (Giai đoạn 2)
VITE_API_BASE_URL=http://localhost:8080/api

# Supabase — CHỈ dùng Project URL và publishable (anon) key.
# TUYỆT ĐỐI không đặt service_role key hay mật khẩu database ở đây.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------
# Tài khoản mẫu cho nút "Dùng tài khoản mẫu" ở trang Đăng nhập.
# Phải ĐĂNG KÝ 2 tài khoản này 1 lần trên web, rồi cấp ADMIN bằng SQL (xem README).
# Chỉ dùng cho thử nghiệm — giá trị này nằm trong mã JS gửi xuống trình duyệt.
# Đặt VITE_SHOW_DEMO_ACCOUNTS=false để ẩn nút khi đưa web lên chạy thật.
# ---------------------------------------------------------------
VITE_SHOW_DEMO_ACCOUNTS=true
VITE_DEMO_ADMIN_EMAIL=admin@thuvien.test
VITE_DEMO_ADMIN_PASSWORD=Admin@2026
VITE_DEMO_USER_EMAIL=docgia@thuvien.test
VITE_DEMO_USER_PASSWORD=Docgia@2026
